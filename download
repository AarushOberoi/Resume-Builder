<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Resume Builder</title>
  <link rel="stylesheet" href="css/fonts.css">
  <link rel="stylesheet" href="css/resume.css">
  <link rel="stylesheet" href="css/app.css">
</head>
<body>
  <!-- menu bar -->
  <header class="menubar">
    <span class="app-mark" title="Resume Builder">R</span>
    <nav class="menus" id="menus">
      <button class="mb-btn" type="button" data-menu="file">File</button>
      <button class="mb-btn" type="button" data-menu="insert">Insert</button>
      <button class="mb-btn" type="button" data-menu="view">View</button>
      <button class="mb-btn" type="button" data-menu="format">Format</button>
      <button class="mb-btn" type="button" data-menu="help">Help</button>
    </nav>
    <div class="doc-title" id="docTitle">Resume</div>
    <div class="mb-right">
      <button class="mb-action" type="button" id="btnTex" title="Download LaTeX source using the original template macros">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
        <span>.tex</span>
      </button>
      <button class="mb-action" type="button" data-menu="layout" id="btnLayout" title="Layout">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M12 4v16"/></svg>
        <span>Layout</span>
      </button>
    </div>
    <div class="menu" id="menuPop" hidden></div>
    <input type="file" id="fileJson" accept="application/json,.json" hidden>
  </header>

  <main class="layout" id="layout">
    <!-- icon rail -->
    <aside class="rail" aria-label="Panels">
      <button class="rail-btn" type="button" data-rail="content" title="Sections">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h6"/></svg>
      </button>
      <button class="rail-btn" type="button" data-rail="setup" title="Page &amp; header">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></svg>
      </button>
      <button class="rail-btn" type="button" data-rail="add" title="Add section">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M12 8v8M8 12h8"/></svg>
      </button>
      <span class="rail-gap"></span>
      <button class="rail-btn" type="button" data-rail="help" title="Formatting help">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01"/></svg>
      </button>
    </aside>

    <!-- editor pane -->
    <section class="editor-pane" aria-label="Resume editor">
      <div class="tabs">
        <div class="tab">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
          resume
        </div>
      </div>
      <div class="toolbar">
        <button class="tb-btn" type="button" data-fmt="b" title="Bold (⌘/Ctrl B)"><b>B</b></button>
        <button class="tb-btn" type="button" data-fmt="i" title="Italic (⌘/Ctrl I)"><i class="serif-i">I</i></button>
        <span class="tb-sep"></span>
        <button class="tb-btn" type="button" data-fmt="arrow" title="Insert arrow →">→</button>
        <button class="tb-btn" type="button" data-fmt="dash" title="Insert en dash –">–</button>
        <span class="tb-sep"></span>
        <button class="tb-btn wide" type="button" data-rail="add" title="Add section">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg> Section
        </button>
        <span class="tb-flex"></span>
      </div>
      <div class="editor" id="editor"></div>
    </section>

    <div class="splitter" id="splitter">
      <button type="button" class="split-arrow" data-pane="preview" title="Preview only">
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
      <button type="button" class="split-arrow" data-pane="editor" title="Editor only">
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
      </button>
    </div>

    <!-- preview pane -->
    <section class="preview-pane" aria-label="Live preview">
      <div class="preview-bar">
        <div class="split-btn">
          <button class="pdf-btn" type="button" id="btnPdf" title="Opens the print dialog — choose “Save as PDF”">Download PDF</button>
          <button class="pdf-caret" type="button" data-menu="export" title="More export options" aria-haspopup="true">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M6 9l6 6 6-6"/></svg>
          </button>
        </div>
        <div class="fit" id="fitStatus"></div>
        <span class="tb-flex"></span>
        <div class="pager">
          <button class="pv-btn" type="button" id="pgPrev" title="Previous page">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 15l-6-6-6 6"/></svg>
          </button>
          <button class="pv-btn" type="button" id="pgNext" title="Next page">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <span class="pg-box" id="pgCur">1</span><span class="pg-of" id="pgTotal">/ 1</span>
        </div>
        <span class="pv-sep"></span>
        <div class="zoom">
          <button class="pv-btn" type="button" id="zoomOut" title="Zoom out">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14"/></svg>
          </button>
          <button class="pv-btn" type="button" id="zoomIn" title="Zoom in">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
          </button>
          <select id="zoomSel" aria-label="Zoom">
            <option value="fit" selected>Fit</option>
            <option value="0.5">50%</option>
            <option value="0.75">75%</option>
            <option value="1">100%</option>
            <option value="1.25">125%</option>
            <option value="1.5">150%</option>
            <option value="2">200%</option>
          </select>
        </div>
      </div>
      <div class="advice" id="advice" hidden></div>
      <div class="preview-scroll" id="previewScroll">
        <div class="pages-scaler" id="pagesScaler">
          <div class="pages" id="pages"></div>
        </div>
      </div>
    </section>
  </main>

  <div class="toast" id="toast" hidden></div>
  <!-- off-screen, unscaled layout area used for exact measurement -->
  <div id="measureRoot" aria-hidden="true"></div>

  <script src="vendor/Sortable.min.js"></script>
  <script src="js/rich.js"></script>
  <script src="js/metrics.js"></script>
  <script src="js/sample.js"></script>
  <script src="js/render.js"></script>
  <script src="js/latex.js"></script>
  <script src="js/app.js"></script>
</body>
</html>
